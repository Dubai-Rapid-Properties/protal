# ---------------------------------------------------------------------------
# D|R|P PMS environment. Nothing below may be hardcoded in source.
# ---------------------------------------------------------------------------

# Supabase (backend: Postgres + Auth + Storage)
# Newer projects issue sb_publishable_... / sb_secret_... keys; older ones the
# JWT-style anon / service_role pair. Set whichever your project shows - the app
# accepts either naming.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        # legacy alternative to the above
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # legacy alternative to the above

# Postgres connection, used only to install the schema and demo data
# (`npm run db:setup -- --seed`).
# Supabase dashboard -> Connect -> Session pooler (IPv4-friendly):
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Storage abstraction: which driver backs the document vault.
# supabase | s3   (s3 kept so the vault can move to AWS without code change)
STORAGE_DRIVER=supabase
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_MEDIA=media

# Payments abstraction. none | ziina | telr | network | stripe
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Messaging abstraction
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Booking notifications are emailed to the office (Company settings email)
# and to owners. Set EMAIL_PROVIDER=resend and a Resend API key, with
# EMAIL_FROM on a domain verified in Resend. With none, portal notifications
# still work and no email is sent.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="D|R|P Property Management <noreply@example.ae>"
SMS_PROVIDER=none
SMS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="D|R|P Property Management"

# Portals. The hostname decides which portal a request belongs to:
# admin.<domain> serves the back office, owner.<domain> the owner portal.
# Locally, open http://admin.localhost:3000 and http://owner.localhost:3000.
ADMIN_URL=http://admin.localhost:3000
OWNER_URL=http://owner.localhost:3000
# Portal to serve on a host with no admin./owner. prefix (e.g. Vercel preview
# URLs). Leave EMPTY in production so unknown hosts serve nothing.
# Under `npm run dev` an empty value means admin, so http://localhost:3000
# opens the back office.
PORTAL_FALLBACK=

# Scheduled jobs (Airbnb calendar import every 15 minutes via Supabase pg_cron).
# Generate with: openssl rand -hex 32. Set the SAME value in Vercel, then run
#   npm run db:cron -- --url https://admin.dubairapidproperties.com
CRON_SECRET=

# The D|R|P website (new-home) builds its Buy / Rent listings from
# /api/public/listings. A Vercel Deploy Hook of the WEBSITE project (Settings
# -> Git -> Deploy Hooks): saving a published listing calls it, so the website
# rebuilds with the change. Leave empty and the website updates on its next
# deploy. WEBSITE_URL is only used for "View on the website" links.
# Holiday Homes website (hh-drp): the secret it sends to book through
# /api/public/bookings. Make one with `openssl rand -hex 32` and set the same
# value as PORTAL_API_KEY in the website project.
WEBSITE_API_KEY=
WEBSITE_DEPLOY_HOOK_URL=
# Only with a GitHub dispatch URL above (https://api.github.com/repos/<owner>/<repo>/dispatches):
# a fine-grained token for the website repo, Contents: read and write.
WEBSITE_DEPLOY_GITHUB_TOKEN=
WEBSITE_URL=https://dubairapidproperties.com
