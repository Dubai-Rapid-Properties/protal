/**
 * Cloudflare Workers: the portal (admin. and owner.dubairapidproperties.com)
 * runs as a Worker through the OpenNext adapter.
 * .github/workflows/deploy-cloudflare.yml builds and deploys it (npm run
 * deploy) on each push to main. Secrets (Supabase keys, Resend, API keys, ...)
 * are set in the Cloudflare dashboard, never here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drp-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "drp-portal"
    }
  ],
  /*
   * Run the Worker next to the database. Supabase is in ap-south-1 (Mumbai)
   * and every page makes several sequential queries, so a Worker at the
   * visitor's nearest edge pays the Dubai-to-Mumbai trip on each one. Pinned
   * to AWS ap-south-1 it pays it once per request (as vercel.json's bom1 did).
   * Change this together with the Supabase region.
   */
  "placement": { "region": "aws:ap-south-1" },
  /* The workers.dev address stays on for testing */
  "workers_dev": true,
  /*
   * The portal's addresses. Routes (not custom domains) so the existing DNS
   * records stay: the Worker answers once a record is proxied (orange cloud),
   * and switching the cloud off sends the address back where it pointed.
   */
  "routes": [
    { "pattern": "admin.dubairapidproperties.com/*", "zone_name": "dubairapidproperties.com" },
    { "pattern": "owner.dubairapidproperties.com/*", "zone_name": "dubairapidproperties.com" }
  ],
  /* Variables and secrets set in the Cloudflare dashboard survive deploys */
  "keep_vars": true,
  "vars": {
    /* The admin team's bookings sheet, read every 15 minutes (src/lib/sheet/sync.ts) */
    "BOOKINGS_SHEET": "10vH_buFA4eEM-xvQIiS4vq688IIb4_NGuW4KUqv4QMM",
    /* Owners choose a password from their invite link (src/lib/env.ts) */
    "OWNER_PASSWORDS": "on"
  },
  "observability": {
    "enabled": true
  }
}
